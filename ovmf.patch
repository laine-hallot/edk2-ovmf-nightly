@@ -107,6 +109,8 @@ PlatformPeim (
   CONST UINT64              *RegProp;
   CONST UINT32              *RangesProp;
   UINT64                    TpmBase;
+  UINT64                    TpmSize;
+  UINT64                    MappingBase;
   EFI_STATUS                Status;
   CHAR8                     DebugLevelBuf[32];
   UINTN                     DebugLevelBufSize;
@@ -197,6 +201,7 @@ PlatformPeim (
                                  );
 
   TpmBase = 0;
+  TpmSize = 0;
 
   //
   // Set Parent to suppress incorrect compiler/analyzer warnings.
@@ -228,8 +233,10 @@ PlatformPeim (
         ASSERT (Len == 8 || Len == 16);
         if (Len == 8) {
           TpmBase = Fdt32ToCpu (RegProp[0]);
+          TpmSize = Fdt32ToCpu (((CONST UINT32 *)RegProp)[1]);
         } else if (Len == 16) {
           TpmBase = Fdt64ToCpu (ReadUnaligned64 ((UINT64 *)RegProp));
+          TpmSize = Fdt64ToCpu (ReadUnaligned64 ((UINT64 *)RegProp + 1));
         }
 
         if (Depth > 1) {
@@ -283,6 +290,19 @@ PlatformPeim (
     if (TpmBase != 0) {
       DEBUG ((DEBUG_INFO, "%a: TPM @ 0x%lx\n", __func__, TpmBase));
 
+      //
+      // The initial memory map does not cover the TPM, so map it before
+      // Tcg2ConfigPei probes it. DXE inherits the mapping.
+      //
+      MappingBase = TpmBase & ~(UINT64)EFI_PAGE_MASK;
+      Status      = ArmSetMemoryAttributes (
+                      MappingBase,
+                      ALIGN_VALUE (TpmBase + TpmSize - MappingBase, EFI_PAGE_SIZE),
+                      EFI_MEMORY_UC,
+                      0
+                      );
+      ASSERT_EFI_ERROR (Status);
+
       Status = (EFI_STATUS)PcdSet64S (PcdTpmBaseAddress, TpmBase);
       ASSERT_EFI_ERROR (Status);
 
